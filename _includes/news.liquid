{% assign items = site.news | sort: 'date' | reverse %}
{% if items.size > 0 %}
  <section class="news" aria-labelledby="news-h">
    <h2 id="news-h">News</h2>
    <div class="news-latest">
      <ul>
        {% for item in items limit: 1 %}
          <li>
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
            <div>{{ item.content | strip }}</div>
          </li>
        {% endfor %}
      </ul>
      {% if items.size > 1 %}
        <button type="button" class="news-toggle" aria-expanded="false" aria-controls="news-older" aria-label="Show older news">
          <span class="chevron" aria-hidden="true"></span>
        </button>
      {% endif %}
    </div>
    {% if items.size > 1 %}
      <div class="news-older" id="news-older">
        <div class="news-older-inner">
          <ul>
            {% for item in items offset: 1 %}
              <li>
                <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
                <div>{{ item.content | strip }}</div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <script>
        (() => {
          const news = document.querySelector('.news');
          const toggle = news.querySelector('.news-toggle');
          const older = news.querySelector('.news-older');
          const set = (open) => {
            news.classList.toggle('open', open);
            toggle.setAttribute('aria-expanded', open);
            toggle.setAttribute('aria-label', open ? 'Hide older news' : 'Show older news');
            older.inert = !open;
          };
          set(false);
          toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            set(!news.classList.contains('open'));
          });
          // the whole latest row toggles too, except clicks on its own links
          news.querySelector('.news-latest').addEventListener('click', (e) => {
            if (!e.target.closest('a')) set(!news.classList.contains('open'));
          });
        })();
      </script>
    {% endif %}
  </section>
{% endif %}
