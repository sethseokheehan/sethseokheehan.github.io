{% assign items = site.news | sort: 'date' | reverse %}
{% if items.size > 0 %}
  <section class="news" aria-labelledby="news-h">
    <h2 id="news-h">News</h2>
    <ul>
      {% for item in items limit: 3 %}
        <li>
          <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
          <div>{{ item.content | strip }}</div>
        </li>
      {% endfor %}
    </ul>
    {% if items.size > 3 %}
      <details class="older-news">
        <summary>Older news</summary>
        <ul>
          {% for item in items offset: 3 %}
            <li>
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
              <div>{{ item.content | strip }}</div>
            </li>
          {% endfor %}
        </ul>
      </details>
    {% endif %}
  </section>
{% endif %}
