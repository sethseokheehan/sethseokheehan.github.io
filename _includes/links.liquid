<nav aria-label="Profile links">
  <ul class="links">
    {%- comment -%} plain text, no mailto: keeps the address away from scrapers {%- endcomment -%}
    <li class="email">{{ site.data.socials.email | replace: '[at]', ' [at] ' }}</li>
    <li><a href="{{ site.data.socials.cv_pdf }}">CV</a></li>
    <li><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a></li>
    <li><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a></li>
  </ul>
</nav>
