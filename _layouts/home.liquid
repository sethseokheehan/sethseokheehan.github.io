---
layout: default
---
<main class="page">
  <section class="intro">
    <div class="intro-text">
      <h1>{{ page.title }}</h1>
      {{ content }}
      {% if page.availability %}
        <p class="availability">{{ page.availability }}</p>
      {% endif %}
      {% include links.liquid %}
    </div>
    <img
      class="photo"
      src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
      width="640"
      height="800"
      alt="Seth playing drums on stage, mid-hit, with a cymbal and drum kit in front of him"
    >
  </section>
  {% include news.liquid %}
  {% include publications.liquid %}
  {% include beyond.liquid %}
</main>
