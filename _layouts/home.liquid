---
layout: default
---
<main class="page">
  <section class="intro">
    <div class="intro-text">
      <h1>
        {{ page.title }}
        <span lang="ko">({{ page.title_ko }})</span>
      </h1>
      {{ content }}
      {% include links.liquid %}
      {% if page.availability %}
        <p class="availability">{{ page.availability }}</p>
      {% endif %}
    </div>
    <img
      class="photo"
      src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
      width="640"
      height="800"
      alt="Seth playing drums on stage, mid-hit, with a cymbal and drum kit in front of him"
    >
  </section>
</main>
