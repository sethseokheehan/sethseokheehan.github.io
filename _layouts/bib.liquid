---
---
<article class="card{% if entry.preview %} has-figure{% endif %}">
  {%- if entry.preview %}
    {%- assign wh = entry.preview_size | split: 'x' %}
    <div class="figure">
      <img
        src="{{ entry.preview | relative_url }}"
        {% if wh.size == 2 %}
          width="{{ wh[0] }}" height="{{ wh[1] }}"
        {% endif %}
        alt="{{ entry.preview_alt | escape }}"
        loading="lazy"
        decoding="async"
      >
    </div>
  {%- endif %}
  <div class="card-text">
    <h3>{{ entry.title | escape }}</h3>
    <p class="authors">
      {%- include authors.liquid -%}
    </p>
    <p class="status">
      {%- if type == 'article' -%}
        {{ entry.journal | escape }}, {{ entry.volume }}({{ entry.number }}), {{ entry.year }}
      {%- elsif type == 'patent' -%}
        {{ entry.number }}, {{ entry.year }}
      {%- elsif entry.archiveprefix == 'arXiv' -%}
        arXiv preprint, {{ entry.year }}
      {%- endif -%}
      {%- if entry.url %}
        &middot;
        <a href="{{ entry.url | escape }}">
          {%- if entry.archiveprefix == 'arXiv' -%}arXiv{%- elsif type == 'patent' -%}Patent record{%- else -%}Paper{%- endif -%}
        </a>
      {%- endif -%}
      {%- if entry.code %}
        &middot; <a href="{{ entry.code | escape }}">Code</a>
      {%- endif -%}
      {%- if entry.dataset %}
        &middot; <a href="{{ entry.dataset | escape }}">Dataset</a>
      {%- endif -%}
    </p>
    {%- if entry.summary %}
      <p class="summary">{{ entry.summary | escape }}</p>
    {%- endif %}
  </div>
</article>
