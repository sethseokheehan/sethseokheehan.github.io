---
---
<article class="card{% if entry.preview %} has-figure{% endif %}{% if entry.url %} linked{% endif %}">
  {%- if entry.url %}
    <svg class="card-arrow" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
      <path d="M3 9 9 3M4.5 3H9v4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  {%- endif %}
  {%- if entry.preview %}
    {%- assign wh = entry.preview_size | split: 'x' %}
    <div class="figure">
      <img
        src="{{ entry.preview | relative_url }}"
        {% if wh.size == 2 %}
          width="{{ wh[0] }}" height="{{ wh[1] }}"
        {% endif %}
        alt="{{ entry.preview_alt | escape }}"
        loading="lazy"
        decoding="async"
      >
    </div>
  {%- endif %}
  <div class="card-text">
    <h3>
      {%- if entry.url -%}
        <a class="card-link" href="{{ entry.url | escape }}">{{ entry.title | escape }}</a>
      {%- else -%}
        {{ entry.title | escape }}
      {%- endif -%}
    </h3>
    <p class="authors">
      {%- include authors.liquid -%}
    </p>
    <p class="status">
      {%- if type == 'article' -%}
        {{ entry.journal | escape }}, {{ entry.year }}
      {%- elsif type == 'patent' -%}
        {{ entry.number }}, {{ entry.year }}
      {%- elsif entry.archiveprefix == 'arXiv' -%}
        arXiv preprint, {{ entry.year }}
      {%- endif -%}
    </p>
    {%- if entry.summary %}
      <p class="summary">{{ entry.summary | escape }}</p>
    {%- endif %}
  </div>
</article>
