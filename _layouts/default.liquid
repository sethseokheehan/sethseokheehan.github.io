{%- if page.url == '/' -%}
  {%- assign page_title = site.title -%}
{%- else -%}
  {%- assign page_title = page.title | append: ' | ' | append: site.title -%}
{%- endif -%}
{%- assign description = page.description | default: site.description -%}
{%- assign share_image = '/assets/img/og.png' | absolute_url -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
      document.documentElement.classList.add('js');
    </script>
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ description | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    {% if page.url == '/404.html' %}
      <meta name="robots" content="noindex">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:description" content="{{ description | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ share_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ site.title }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title }}">
    <meta name="twitter:description" content="{{ description | escape }}">
    <meta name="twitter:image" content="{{ share_image }}">
    <link rel="icon" href="{{ '/favicon.ico' | relative_url }}" sizes="any">
    <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | relative_url }}">
    <link rel="preload" href="{{ '/assets/fonts/instrument-sans-latin-wght.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}?v={{ site.time | date: '%s' }}">
    {% if page.url == '/' %}
      {%- assign socials = site.data.socials -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": {{ site.title | jsonify }},
          "alternateName": "한석희",
          "url": {{ '/' | absolute_url | jsonify }},
          "image": {{ '/assets/img/prof_pic.jpg' | absolute_url | jsonify }},
          "affiliation": { "@type": "CollegeOrUniversity", "name": "Dartmouth College" },
          "sameAs": [
            {{ 'https://scholar.google.com/citations?user=' | append: socials.scholar_userid | jsonify }},
            {{ 'https://www.linkedin.com/in/' | append: socials.linkedin_username | append: '/' | jsonify }}
          ]
        }
      </script>
    {% endif %}
  </head>
  <body>
    {{ content }}
  </body>
</html>
